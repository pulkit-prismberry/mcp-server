# PostgreSQL Connection Settings (aligned with support_ai-backend)
PGHOST=localhost
PGPORT=5433
PGDATABASE=support_ai_db
PGUSER=postgres
PGPASSWORD=postgres
PGSCHEMA=public
PGSSLMODE=prefer

# Or provide a single connection URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/support_ai_db

# Backend API & Auth Context Resolution
BACKEND_URL=http://localhost:8000
VERIFY_TOKEN_MODE=auto
REQUIRE_AUTH_CONTEXT=true

# JWT Settings (must match support_ai-backend)
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=support-ai-backend
JWT_AUDIENCE=support-ai-services

# Fallback to mock data if PostgreSQL is unreachable (true/false)
USE_MOCK_FALLBACK=false
